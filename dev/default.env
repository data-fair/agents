# Defaults of the dev environment: fixed ports, no tooling needed.
# `npm run dev-deps` copies this file to .env when there is none; .env overrides it
# (it is never overwritten, edit it freely).
# Ports stay in 5700-5749 so that they rarely collide with other local services.
DEV_HOST=localhost
SSRF_PUBLIC_IPS=127.0.0.1,::1
NGINX_PORT=5700
DEV_API_PORT=5701
DEV_UI_PORT=5702
DEV_UI_HMR_PORT=5703
DEV_OBSERVER_PORT=5704
DEV_MCP_PORT=5705
MCP_FIXTURE_PORT=5706
BRIDGE_PORT=5707
MONGO_PORT=5708
SD_PORT=5709
EVENTS_PORT=5710
DF_PORT=5711
