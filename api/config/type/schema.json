{
  "$id": "https://github.com/data-fair/agents/api/config",
  "x-exports": [
    "types",
    "validate"
  ],
  "x-ajv": {
    "coerceTypes": "array"
  },
  "type": "object",
  "title": "Api config",
  "additionalProperties": false,
  "required": [
    "privateDirectoryUrl",
    "mongoUrl",
    "port",
    "tmpDir",
    "observer",
    "secretKeys",
    "cipherPassword",
    "requireAnonymousActionToken",
    "eurosPerCredit",
    "defaultLimits",
    "compactionPercent",
    "turnCredits",
    "liveTurnsPerCaller",
    "turnTimeoutSeconds",
    "shutdownGraceSeconds",
    "taskTimeoutSeconds",
    "codeModeMaxWorkers",
    "tasks"
  ],
  "$defs": {
    "modelRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "id"],
      "properties": {
        "provider": { "type": "string" },
        "id": { "type": "string" }
      }
    }
  },
  "properties": {
    "mongoUrl": {
      "type": "string"
    },
    "port": {
      "type": "number"
    },
    "tmpDir": {
      "type": "string"
    },
    "privateDirectoryUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "privateEventsUrl": {
      "type": "string"
    },
    "secretKeys": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "events": {
          "type": "string"
        },
        "limits": {
          "type": "string"
        }
      }
    },
    "providers": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "name"],
        "properties": {
          "type": { "type": "string", "enum": ["openai", "anthropic", "google", "mistral", "openrouter", "ollama", "scaleway", "openai-compatible", "mock"] },
          "id": { "type": "string" },
          "name": { "type": "string" },
          "enabled": { "type": "boolean", "default": true },
          "apiKey": { "type": "string" },
          "baseURL": { "type": "string" },
          "projectId": { "type": "string" },
          "compatibility": { "type": "string", "enum": ["default", "compatible"] }
        }
      }
    },
    "models": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "provider", "usage", "inputPricePerMillion", "outputPricePerMillion"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "provider": { "type": "string" },
          "usage": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["assistant", "tools", "summarizer", "moderator"] } },
          "contextWindow": { "type": "number", "minimum": 0 },
          "inputPricePerMillion": { "type": "number", "minimum": 0 },
          "outputPricePerMillion": { "type": "number", "minimum": 0 },
          "cachedInputPricePerMillion": { "type": "number", "minimum": 0 }
        }
      }
    },
    "mcpServers": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "url", "auth"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "url": { "type": "string" },
          "auth": { "type": "string", "enum": ["nhi-session", "none", "apiKey"] },
          "apiKeyHeader": { "type": "string" },
          "apiKey": { "type": "string" },
          "sites": { "type": "string", "enum": ["home", "all"], "description": "Site-bound entries only. home: the turn's home site only, with the agent's session. all (default): every site, anonymously outside the account." },
          "homeAlternative": { "type": "string", "description": "On a sites home entry: the sites all entry that serves every other site, left out of the home site." }
        }
      }
    },
    "personalAssistants": {
      "type": "object",
      "additionalProperties": false,
      "description": "The servers of each built-in personal assistant: references into mcpServers, like a configured agent's. Unset: no catalog servers.",
      "default": {},
      "properties": {
        "portal": { "type": "object", "additionalProperties": false, "properties": { "mcpServers": { "type": "array", "default": [], "items": { "type": "object", "additionalProperties": false, "required": ["serverId"], "properties": { "serverId": { "type": "string" }, "toolFilter": { "type": "array", "items": { "type": "string" } } } } } } },
        "backOffice": { "type": "object", "additionalProperties": false, "properties": { "mcpServers": { "type": "array", "default": [], "items": { "type": "object", "additionalProperties": false, "required": ["serverId"], "properties": { "serverId": { "type": "string" }, "toolFilter": { "type": "array", "items": { "type": "string" } } } } } } }
      }
    },
    "autonomousAgentsRequireAdminMode": { "type": "boolean", "default": true },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minIntervalSeconds", "maxPerAgent", "pollSeconds", "maxConsecutiveFailures"],
      "properties": {
        "minIntervalSeconds": { "type": "integer", "minimum": 60, "default": 3600, "description": "A task schedule may not fire more often than this." },
        "maxPerAgent": { "type": "integer", "minimum": 1, "default": 20, "description": "Planned tasks one autonomous agent may hold." },
        "pollSeconds": { "type": "integer", "minimum": 1, "default": 10, "description": "How often the scheduler looks for due tasks." },
        "maxConsecutiveFailures": { "type": "integer", "minimum": 1, "default": 5, "description": "Failed runs in a row after which a task is paused." }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "secret", "publicUrl"],
      "description": "The file store of autonomous agents (docs/architecture/agent-files.md). Unset: files are off.",
      "properties": {
        "storage": { "type": "string", "enum": ["fs", "s3"] },
        "dataDir": { "type": "string", "description": "fs: a directory on a volume shared by every node when the service is scaled." },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "region": { "type": "string" },
            "endpoint": { "type": "string" },
            "bucket": { "type": "string" },
            "credentials": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "accessKeyId": { "type": "string" },
                "secretAccessKey": { "type": "string" }
              }
            },
            "forcePathStyle": { "type": "boolean" }
          }
        },
        "secret": { "type": "string", "minLength": 32, "description": "Signs the file URLs MCP servers fetch." },
        "publicUrl": { "type": "string", "pattern": "^https?://", "description": "The agents API base URL as MCP servers reach it: what they configure as FILE_URL_PREFIXES." }
      }
    },
    "defaultModels": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "assistant": { "$ref": "#/$defs/modelRef" },
        "tools": { "$ref": "#/$defs/modelRef" },
        "summarizer": { "$ref": "#/$defs/modelRef" },
        "moderator": { "$ref": "#/$defs/modelRef" }
      }
    },
    "eurosPerCredit": { "type": "number", "exclusiveMinimum": 0, "default": 0.008 },
    "defaultLimits": {
      "type": "object",
      "additionalProperties": false,
      "default": { "credits": 0 },
      "properties": { "credits": { "type": "number", "default": 0 } }
    },
    "observer": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "port": {
          "type": "number"
        }
      }
    },
    "upgradeRoot": {
      "type": "string"
    },
    "cipherPassword": {
      "type": "string"
    },
    "requireAnonymousActionToken": {
      "type": "boolean",
      "default": true
    },
    "util": {},
    "get": {},
    "has": {},
    "compactionPercent": {
      "type": "number",
      "title": "Compaction percent",
      "description": "Share of the assistant model's context window above which conversation history is compacted.",
      "default": 70,
      "minimum": 10,
      "maximum": 100
    },
    "turnCredits": {
      "type": "number",
      "title": "Turn credit budget",
      "description": "Credits one turn may spend before it is stopped — any turn, the chat's as well as an autonomous agent's. The account credit cap still applies on top of this.",
      "default": 5,
      "minimum": 0
    },
    "liveTurnsPerCaller": {
      "type": "integer",
      "title": "Turns at once per caller",
      "description": "How many chat turns one person — or one anonymous visitor's address — may have running at once. A further prompt is refused (429) until one ends. Quotas are re-checked between steps, so this bounds how far turns started together can overshoot one.",
      "default": 5,
      "minimum": 1
    },
    "turnTimeoutSeconds": {
      "type": "number",
      "title": "Turn timeout (seconds)",
      "description": "Wall-clock ceiling for one chat turn, so a hanging model or MCP server cannot hold a conversation's lock. A planned task run has its own, taskTimeoutSeconds.",
      "default": 300,
      "minimum": 10
    },
    "taskTimeoutSeconds": {
      "type": "integer",
      "minimum": 10,
      "default": 1800,
      "description": "Wall-clock ceiling of one planned task's run. Longer than a chat turn's: nobody waits on it, and code mode and files make long runs the normal case."
    },
    "codeModeMaxWorkers": {
      "type": "integer",
      "minimum": 1,
      "default": 4,
      "description": "How many code_mode scripts this process runs at once (one QuickJS worker each, up to 64 MiB). A script started while all are busy is refused, not queued."
    },
    "shutdownGraceSeconds": {
      "type": "number",
      "title": "Shutdown grace (seconds)",
      "description": "On SIGTERM, how long running turns are given to finish before they are stopped as 'the server restarted'. The pod's terminationGracePeriodSeconds must exceed it.",
      "default": 90,
      "minimum": 0
    }
  }
}
