{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true
  },
  // dev/ is excluded, but the claude-bridge is real code with real complexity:
  // list dev/ subtrees explicitly so dev/claude-bridge stays in the program.
  "exclude": ["node_modules", ".type", "ui", "dev/fixtures.ts", "dev/logs", "dev/resources", "dev/scripts", "test-it", "eslint.config.mjs"]
}