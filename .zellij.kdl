layout {
    pane {
      split_direction "vertical"
      pane name="agents" borderless=true {
        command "bash"
        args "-ic" "nvm use > /dev/null 2>&1 && bash"
      }
      pane name="deps" {
        command "bash"
        args "-ic" "npm run dev-deps"
      }
    }
    pane {
      split_direction "vertical"
      pane name="ui" {
        command "bash"
        args "-ic" "nvm use > /dev/null 2>&1 && npm -w ui run dev"
      }
      pane name="api" {
        command "bash"
        args "-ic" "nvm use > /dev/null 2>&1 && npm -w api run dev"
      }
      // Optional: only needed to run the workspace on Claude Code subscription
      // models, and for npm run simulate. Idle it costs nothing.
      pane name="bridge" {
        command "bash"
        args "-ic" "nvm use > /dev/null 2>&1 && npm run dev-bridge"
      }
    }
    pane size=2 borderless=true {
        command "bash"
        args "-ic" "echo -n -e \"Dev server available at \\e[1;96mhttp://localhost:$NGINX_PORT\\033[0m\""
    }
}
